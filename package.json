{
  "name": "kalan-front",
  "productName": "kalan",
  "version": "0.1.0",
  "description": "kalan front end: installment-first credit card tracker",
  "author": "kalan contributors",
  "main": "desktop/dist/main.js",
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env VITE_KALAN_MOCK=1 vite",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && vite build --mode mock",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit && tsc -p desktop/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "shots": "node scripts/shots.mjs",
    "desktop:compile": "tsc -p desktop/tsconfig.build.json",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:dev:mock": "cross-env VITE_KALAN_MOCK=1 node scripts/desktop-dev.mjs",
    "desktop:build": "npm run build && npm run desktop:compile && electron-builder --config desktop/electron-builder.yml --win nsis",
    "desktop:fetch-back": "node scripts/fetch-back.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "i18next": "^27.2.9",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "private": true,
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false
  }
}
